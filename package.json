{
  "name": "intellidecision-ai-root",
  "version": "1.0.0",
  "description": "IntelliDecision AI – Explainable AI-Powered Decision Intelligence System",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "start": "node server/src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "@google/genai": "^0.3.1",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "keywords": [
    "decision-intelligence",
    "explainable-ai",
    "gemini",
    "supabase",
    "analytics"
  ],
  "author": "IntelliDecision AI Team",
  "license": "MIT"
}
